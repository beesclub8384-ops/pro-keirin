# 릴리스 서명 키 설정 예시.
#
# 이 파일을 android/keystore.properties 로 복사한 뒤 실제 값을 채운다.
# keystore.properties 와 .jks 파일은 .gitignore 대상이다 — 절대 커밋하지 말 것.
# 키 발급 명령과 백업 경고는 docs/capacitor-build.md 참고.
#
# storeFile: android/ 폴더 기준 상대경로 또는 절대경로.
#   예) 상대경로 — android/sevenrandoms-release.jks 에 두는 경우
#       storeFile=sevenrandoms-release.jks
#   예) 절대경로 — 키를 레포 밖에 두는 경우 (권장)
#       storeFile=C:/keys/sevenrandoms-release.jks
#   (윈도우 경로는 역슬래시 대신 슬래시를 쓰거나 \\ 로 이스케이프한다)

storeFile=sevenrandoms-release.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=sevenrandoms
keyPassword=여기에_키_비밀번호
